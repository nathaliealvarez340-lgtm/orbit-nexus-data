model Quote {
  id                     String             @id @default(cuid())
  companyId              String
  clientId               String?
  createdById            String?
  quoteNumber            String
  status                 QuoteStatus        @default(DRAFT)
  invoiceStatus          QuoteInvoiceStatus @default(NOT_READY)
  invoicePreparedAt      DateTime?
  clientName             String
  clientCompany          String
  clientEmail            String
  validUntil             DateTime?
  commercialTerms        String
  clientType             QuoteClientType    @default(NEW)
  complexity             QuoteComplexity    @default(MEDIUM)
  urgency                QuoteUrgency       @default(STANDARD)
  currency               String             @default("MXN")
  subtotalCents          Int                @default(0)
  discountCents          Int                @default(0)
  surchargeCents         Int                @default(0)
  taxCents               Int                @default(0)
  totalCents             Int                @default(0)
  estimatedProfitCents   Int                @default(0)
  estimatedMarginPercent Float              @default(0)
  requiresApproval       Boolean            @default(false)
  shareToken             String             @unique
  printableSnapshot      Json?
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client                 QuoteClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy              User?              @relation("CreatedQuotes", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems              QuoteLineItem[]
  events                 QuoteEvent[]
  invoice                Invoice?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([companyId, quoteNumber])
  @@index([companyId, status, updatedAt])
  @@index([companyId, clientEmail])
  @@map("quotes")
}

