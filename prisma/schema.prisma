  owner           User?              @relation("OwnedTasks", fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignee        User?              @relation("AssignedTasks", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  alerts          OperationalAlert[]
  activityLogs    ActivityLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId, status, priority])
  @@index([projectId, dueAt])
  @@map("tasks")
}

